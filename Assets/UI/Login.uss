.game-title {
    -unity-font: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=f3cf74c903db5a646b0f0344a0f1dba2&type=3#NotInter-Regular");
    -unity-font-definition: url("project://database/Assets/Fonts/Teste.asset?fileID=11400000&guid=fd31c54ad8169e04eac1446dd88cad3b&type=2#Teste");
    font-size: 62px;
    -unity-text-align: upper-center;
    color: rgb(92, 55, 165);
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.font-panel {
    -unity-font-definition: url("project://database/Assets/Fonts/Teste.asset?fileID=11400000&guid=fd31c54ad8169e04eac1446dd88cad3b&type=2#Teste");
    color: rgb(255, 255, 255);
    width: auto;
    font-size: 22px;
}

.panel {
    font-size: 15px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    width: 100%;
    height: 70%;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgb(93, 174, 98);
}

.main-button {
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    width: auto;
    height: auto;
}

.main-button:active {
    background-color: rgb(253, 95, 75);
}

Button:hover {
    scale: 1.02 1.02;
}

.secondary-button {
    height: auto;
    width: auto;
    -unity-text-align: middle-center;
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
}

.secondary-button:active {
    background-color: rgb(75, 255, 95);
}

.container {
    width: 100%;
    height: 100%;
}

Button {
    transition-duration: 0.05s;
    transition-timing-function: ease-in;
}
